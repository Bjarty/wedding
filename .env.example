# Alle waarden zijn openbaar. Zet enabled pas op true nadat de RSVP-testomgeving
# end-to-end is gecontroleerd. Iedere andere waarde houdt het formulier uit.
# Houd ook de bevestigingsmail-vlag false tot de mailstroom volledig is getest.
VITE_RSVP_ENABLED=false
VITE_RSVP_HOUSEHOLD_CODES_ENABLED=false
VITE_RSVP_CONFIRMATION_EMAIL_ENABLED=false
VITE_RSVP_API_BASE_URL=
VITE_TURNSTILE_SITE_KEY=
